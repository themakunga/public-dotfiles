# newsboat config — Tokyo Night theme

auto-reload yes
reload-time 60
max-items 100
show-read-feeds yes
show-read-articles yes
browser open

# --- Tokyo Night palette ---
# bg: #1a1b26  fg: #c0caf5  blue: #7aa2f7  cyan: #7dcfff
# green: #9ece6a  yellow: #e0af68  red: #f7768e  purple: #9d7cd8

color background          default   default
color listnormal          color189  default
color listfocus           color117  color237  bold
color listnormal_unread   color117  default   bold
color listfocus_unread    color117  color237  bold
color info                color110  color236  bold
color article             color189  default

highlight article "^Feed:.*"        color110  default  bold
highlight article "^Title:.*"       color117  default  bold
highlight article "^Author:.*"      color176  default
highlight article "^Date:.*"        color179  default
highlight article "^Link:.*"        color81   default
highlight article "https?://[^ ]+"  color81   default  underline
