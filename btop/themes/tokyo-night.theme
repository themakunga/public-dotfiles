# Theme: Tokyo Night Moon (Matching Tmux Config)
# Based on the original Tokyo Night theme, adapted for Moon palette

# Main bg (thm_bg)
theme[main_bg]="#222436"

# Main text color (thm_fg)
theme[main_fg]="#c8d3f5"

# Title color for boxes (thm_blue)
theme[title]="#82aaff"

# Highlight color for keyboard shortcuts (thm_cyan)
theme[hi_fg]="#86e1fc"

# Background color of selected item in processes box (thm_black4)
theme[selected_bg]="#444a73"

# Foreground color of selected item in processes box (thm_fg)
theme[selected_fg]="#c8d3f5"

# Color of inactive/disabled text (thm_gray)
theme[inactive_fg]="#3a3f5a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text (thm_magenta)
theme[proc_misc]="#c099ff"

# Box outline colors (thm_gray - same as tmux pane borders)
theme[cpu_box]="#3a3f5a"
theme[mem_box]="#3a3f5a"
theme[net_box]="#3a3f5a"
theme[proc_box]="#3a3f5a"

# Box divider line and small boxes line color (thm_gray)
theme[div_line]="#3a3f5a"

# ------------------------------------------------------------------------------
# Gradients (thm_green -> thm_yellow -> thm_red)
# ------------------------------------------------------------------------------

# Temperature graph colors
theme[temp_start]="#c3e88d"
theme[temp_mid]="#ffc777"
theme[temp_end]="#ff757f"

# CPU graph colors
theme[cpu_start]="#c3e88d"
theme[cpu_mid]="#ffc777"
theme[cpu_end]="#ff757f"

# Mem/Disk free meter
theme[free_start]="#c3e88d"
theme[free_mid]="#ffc777"
theme[free_end]="#ff757f"

# Mem/Disk cached meter
theme[cached_start]="#c3e88d"
theme[cached_mid]="#ffc777"
theme[cached_end]="#ff757f"

# Mem/Disk available meter
theme[available_start]="#c3e88d"
theme[available_mid]="#ffc777"
theme[available_end]="#ff757f"

# Mem/Disk used meter
theme[used_start]="#c3e88d"
theme[used_mid]="#ffc777"
theme[used_end]="#ff757f"

# Download graph colors (thm_cyan -> thm_blue -> thm_magenta)
theme[download_start]="#86e1fc"
theme[download_mid]="#82aaff"
theme[download_end]="#c099ff"

# Upload graph colors (thm_green -> thm_yellow -> thm_orange)
theme[upload_start]="#c3e88d"
theme[upload_mid]="#ffc777"
theme[upload_end]="#ff9e64"
