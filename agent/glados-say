#!/usr/bin/env bash
# Legacy runtime entrypoint; event selection belongs to the standalone GLaDOS skill.
case "${1:-}" in
  start|stop|notify|decision|success|failure)
    echo "GLaDOS event selection moved to glados-agent; legacy announcements are disabled." >&2
    exit 1
    ;;
esac
exec /run/current-system/sw/bin/glados-say "$@"
