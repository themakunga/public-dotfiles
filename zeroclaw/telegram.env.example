# ─────────────────────────────────────────────────────────────────────────────
# GLaDOS — Telegram secrets template
#
# NUNCA incluir este archivo con valores reales en ningún repositorio.
# Copiar a /opt/glados/config/.env y rellenar con los valores reales.
#
# Fuente del token: BotFather (@BotFather en Telegram)
# Fuente de chat IDs: @userinfobot o /getUpdates en la API de Telegram
#
# Estado de secrets management:
#   Objetivo final → SOPS + age (key derivada de /etc/ssh/ssh_host_ed25519_key)
#   Mientras tanto  → este archivo en /opt/glados/config/.env (chmod 600)
# ─────────────────────────────────────────────────────────────────────────────

# ── Bot de Telegram (BotFather) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<token-from-botfather>

# ── Chat IDs de usuarios autorizados ─────────────────────────────────────────
# Obtener con: curl https://api.telegram.org/bot<TOKEN>/getUpdates
# (enviar un mensaje al bot primero para que aparezca en updates)
TELEGRAM_CHAT_NICOLAS=<nicolas-chat-id>   # @TheMakunga
TELEGRAM_CHAT_MEDDY=<meddy-chat-id>       # @Mighty_Meddy

# ── Tokens de integración (opcionales) ───────────────────────────────────────
GITLAB_TOKEN=<gitlab-personal-access-token>
GITHUB_TOKEN=<github-personal-access-token>
ZEROCLAW_API_KEY=<api-key-for-programmatic-access>
