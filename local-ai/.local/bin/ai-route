#!/usr/bin/env bash
source "$HOME/.config/ai/common.sh"
[[ $# -gt 0 ]] || die 'Usage: ai-route <prompt>'
cap=$(jq -er --arg prompt "$*" 'first(.rules[] | select(.pattern as $p | $prompt | test($p; "i")) | .capability) // .default' "$AI_CONFIG/routing.json")
jq -e --slurpfile policy "$AI_CONFIG/routing.json" --arg cap "$cap" '.[$cap] + {capability:$cap, candidates: (($policy[0].models[$cap] // []) | map("local/" + .)) + (if $policy[0].models[$cap] then [($policy[0].fallback.providerID + "/" + $policy[0].fallback.id)] else [] end)} | select(.model != null)' "$AI_CONFIG/capabilities.json"
