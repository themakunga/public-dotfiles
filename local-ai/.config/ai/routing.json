{
  "default": "text",
  "rules": [
    {
      "capability": "image",
      "pattern": "(genera|crea|dibuja|generate|draw).*(imagen|image|ilustraci\u00f3n|illustration)"
    },
    {
      "capability": "vision",
      "pattern": "(analiza|describe|explain).*(imagen|image|screenshot|captura)"
    },
    {
      "capability": "transcribe",
      "pattern": "transcrib|transcript"
    },
    {
      "capability": "speak",
      "pattern": "lee en voz alta|text.to.speech|sintetiza voz"
    },
    {
      "capability": "embed",
      "pattern": "embedding|vectoriza"
    },
    {
      "capability": "reasoning",
      "pattern": "arquitectura|architecture|debug|depur|seguridad|security|race condition|concurrency|concurrencia|dise\u00f1o|design|rendimiento|performance|deadlock|matem[a\u00e1]tica|reason|razona"
    },
    {
      "capability": "code",
      "pattern": "\\b(implement\\w*|refactor\\w*|tests?|funci[o\u00f3]n|functions?|c[o\u00f3]digo|code|typescript|golang|python|javascript|nix|compila\\w*)\\b"
    }
  ],
  "models": {
    "text": ["flash", "fast", "coder", "reasoning"],
    "code": ["coder", "reasoning", "fast", "flash"],
    "reasoning": ["reasoning", "coder", "fast", "flash"]
  },
  "fallback": {
    "providerID": "openai",
    "id": "gpt-6.1-sol"
  },
  "headroom": 8192
}
